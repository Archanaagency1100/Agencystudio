


RewriteEngine On

# Dynamic sitemap
RewriteRule ^sitemap\.xml/?$ sitemap.php [L]

# Clean article detail URL
RewriteRule ^studio/articles/([^/]+)/?$ /studio/articles.html?slug=$1 [L,QSA,NC]

# Redirect direct old article URLs to clean URLs
RewriteCond %{THE_REQUEST} \s/+studio/articles\.html\?slug=([^&\s]+) [NC]
RewriteRule ^studio/articles\.html$ /studio/articles/%1? [R=301,L,NE]

# Load .html pages through clean URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
